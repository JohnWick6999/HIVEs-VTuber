<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AIVtuberTool.ModernMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIVtuberTool"
        mc:Ignorable="d"
        Title="Neuro - AI VTuber Control Center"
        Height="900"
        Width="1400"
        WindowState="Maximized"
        Background="#FF2D2D30"
        Foreground="White">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 顶部导航栏 -->
        <Border Grid.Row="0" Background="#FF252526" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🤖 Neuro" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,20,0"/>
                    
                    <Button x:Name="HomeButton" Content="首页" Style="{StaticResource NavigationButtonStyle}" Margin="0,0,10,0"/>
                    <Button x:Name="ChatButton" Content="对话" Style="{StaticResource NavigationButtonStyle}" Margin="0,0,10,0"/>
                    <Button x:Name="ControlButton" Content="控制台" Style="{StaticResource NavigationButtonStyle}" Margin="0,0,10,0"/>
                    <Button x:Name="SettingsButton" Content="设置" Style="{StaticResource NavigationButtonStyle}" Margin="0,0,10,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionStatusText" Text="🔴 未连接" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button x:Name="RefreshConnectionButton" Content="🔄 刷新" Width="80" Height="30" Margin="0,0,10,0"/>
                    <Button x:Name="ExitButton" Content="退出" Width="80" Height="30"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧边栏 -->
            <Border Grid.Column="0" Background="#FF2D2D2D" BorderBrush="#FF3E3E40" BorderThickness="0,0,1,0">
                <StackPanel Margin="15">
                    <TextBlock Text="功能面板" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    
                    <Button x:Name="ChatPanelButton" Content="💬 对话中心" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,5"/>
                    <Button x:Name="VoicePanelButton" Content="🎙️ 语音控制" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,5"/>
                    <Button x:Name="MediaPanelButton" Content="🖼️ 媒体处理" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,5"/>
                    <Button x:Name="OBSPanelButton" Content="📹 OBS控制" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,5"/>
                    <Button x:Name="VTSPanelButton" Content="🎭 VTube控制" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,5"/>
                    <Button x:Name="PersonalityPanelButton" Content="🧠 人格设定" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,5"/>
                    <Button x:Name="ConfigPanelButton" Content="⚙️ 配置管理" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,5"/>
                    <Button x:Name="LogsPanelButton" Content="📋 日志监控" Style="{StaticResource SidebarButtonStyle}" Margin="0,0,0,5"/>
                </StackPanel>
            </Border>
            
            <!-- 右侧内容区域 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- 状态概览卡片 -->
                    <Border Background="#FF3E3E42" CornerRadius="8" Margin="0,0,0,20">
                        <Grid Margin="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="10">
                                <TextBlock Text="后端服务" FontSize="14" Foreground="LightGray"/>
                                <TextBlock x:Name="BackendStatusValue" Text="🔴 未运行" FontSize="16" FontWeight="Bold" Foreground="Red" Margin="0,5,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="10">
                                <TextBlock Text="OBS连接" FontSize="14" Foreground="LightGray"/>
                                <TextBlock x:Name="OBSStatusValue" Text="🔴 未连接" FontSize="16" FontWeight="Bold" Foreground="Red" Margin="0,5,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2" Margin="10">
                                <TextBlock Text="VTS连接" FontSize="14" Foreground="LightGray"/>
                                <TextBlock x:Name="VTSStatusValue" Text="🔴 未连接" FontSize="16" FontWeight="Bold" Foreground="Red" Margin="0,5,0,0"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="3" Margin="10">
                                <TextBlock Text="AI状态" FontSize="14" Foreground="LightGray"/>
                                <TextBlock x:Name="AIStatusValue" Text="🔴 未就绪" FontSize="16" FontWeight="Bold" Foreground="Red" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- 对话区域 -->
                    <Expander Header="💬 对话中心" IsExpanded="True" Margin="0,0,0,20">
                        <Border Background="#FF3E3E42" CornerRadius="8" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <ScrollViewer Grid.Row="0" x:Name="ChatHistoryScrollViewer" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ChatHistoryList" Background="Transparent"/>
                                </ScrollViewer>
                                
                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="ChatInputTextBox" 
                                             Grid.Column="0" 
                                             Height="60"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             FontSize="14"
                                             Padding="10"/>
                                    <Button x:Name="SendMessageButton" 
                                            Grid.Column="1" 
                                            Content="发送" 
                                            Width="80" 
                                            Height="60"
                                            Margin="10,0,0,0"
                                            FontSize="14"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Expander>
                    
                    <!-- 快捷控制按钮 -->
                    <Expander Header="⚡ 快捷控制" IsExpanded="True" Margin="0,0,0,20">
                        <Border Background="#FF3E3E42" CornerRadius="8" Padding="15">
                            <WrapPanel Orientation="Horizontal" ItemWidth="150" ItemHeight="40">
                                <Button x:Name="StartRecordingButton" Content="⏺️ 录制" Margin="5" Height="35" Width="140"/>
                                <Button x:Name="StopRecordingButton" Content="⏹️ 停止录制" Margin="5" Height="35" Width="140"/>
                                <Button x:Name="StartStreamingButton" Content="🎬 推流" Margin="5" Height="35" Width="140"/>
                                <Button x:Name="StopStreamingButton" Content="❌ 停止推流" Margin="5" Height="35" Width="140"/>
                                <Button x:Name="ConnectOBSButton" Content="🔌 连接OBS" Margin="5" Height="35" Width="140"/>
                                <Button x:Name="ConnectVTSButton" Content="🔌 连接VTS" Margin="5" Height="35" Width="140"/>
                                <Button x:Name="StartASRButton" Content="🎤 开始听写" Margin="5" Height="35" Width="140"/>
                                <Button x:Name="StopASRButton" Content="🔇 停止听写" Margin="5" Height="35" Width="140"/>
                            </WrapPanel>
                        </Border>
                    </Expander>
                    
                    <!-- 人格设定预览 -->
                    <Expander Header="🧠 当前人格设定" IsExpanded="False" Margin="0,0,0,20">
                        <Border Background="#FF3E3E42" CornerRadius="8" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" x:Name="CurrentPersonaName" Text="人格名称：" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Grid.Row="1" x:Name="CurrentPersonaDescription" Text="人格描述：" FontSize="14" Foreground="LightGray" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="2" x:Name="CurrentPersonaGreeting" Text="问候语：" FontSize="14" Foreground="LightGray" Margin="0,5,0,0"/>
                                <TextBlock Grid.Row="3" x:Name="CurrentPersonaTone" Text="语气：" FontSize="14" Foreground="LightGray" Margin="0,5,0,0"/>
                            </Grid>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
    
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF555557"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF4A4A4F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF3E3E42"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF555557"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF4A4A4F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>