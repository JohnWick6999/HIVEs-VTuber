<Window x:Class="AIVtuberTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIVtuberTool"
        mc:Ignorable="d"
        Title="AI Vtuber Tool"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Visibility="Visible"
        ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl x:Name="MainTabControl" Margin="10">
            <!-- 配置管理标签页 -->
            <TabItem Header="配置管理">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <Button x:Name="LoadConfigButton" Content="加载配置"/>
                        <Button x:Name="SaveConfigButton" Content="保存配置"/>
                        <Button x:Name="ResetConfigButton" Content="重置配置"/>
                    </StackPanel>
                    <TabControl Grid.Row="1" x:Name="ConfigTabControl">
                        <TabItem Header="Chat API">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key:"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ChatApiKeyTextBox"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL:"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ChatBaseUrlTextBox"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Model:"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ChatModelTextBox"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Temperature:"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ChatTemperatureTextBox"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Max Tokens:"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="ChatMaxTokensTextBox"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="语音 API">
                            <TabControl>
                                <TabItem Header="TTS">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key:"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TtsApiKeyTextBox"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL:"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TtsBaseUrlTextBox"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Voice:"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TtsVoiceTextBox"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="ASR">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key:"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="AsrApiKeyTextBox"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL:"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="AsrBaseUrlTextBox"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </TabItem>
                        <TabItem Header="图片识别 API">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key:"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="ImageApiKeyTextBox"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL:"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ImageBaseUrlTextBox"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="搜索 API">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="API Key:"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SearchApiKeyTextBox"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL:"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SearchBaseUrlTextBox"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="数据库">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="启用:"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="DatabaseEnabledCheckBox"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="DB Path:"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DatabasePathTextBox"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="OBS">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="启用:"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="ObsEnabledCheckBox"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Host:"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="ObsHostTextBox"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Port:"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="ObsPortTextBox"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Password:"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="ObsPasswordTextBox"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="VTuberStudio">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="启用:"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" x:Name="VtsEnabledCheckBox"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Host:"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="VtsHostTextBox"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Port:"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="VtsPortTextBox"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="人格设定">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="姓名:"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="PersonalityNameTextBox"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="描述:"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="PersonalityDescriptionTextBox" TextWrapping="Wrap" Height="100"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="问候语:"/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="PersonalityGreetingTextBox"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="语气:"/>
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="PersonalityToneTextBox"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                    <TextBlock Grid.Row="2" x:Name="ConfigStatusTextBlock" Margin="5" Foreground="Green"/>
                </Grid>
            </TabItem>
            <!-- 聊天标签页 -->
            <TabItem Header="聊天">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox Grid.Row="0" x:Name="ChatHistoryListBox" Margin="5"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBox Grid.Row="1" x:Name="ChatInputTextBox" Width="*"/>
                        <Button Grid.Row="1" x:Name="SendButton" Content="发送" Width="100"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" x:Name="ChatStatusTextBlock" Margin="5" Foreground="Green"/>
                </Grid>
            </TabItem>
            <!-- 语音标签页 -->
            <TabItem Header="语音">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="TTS (文本转语音)" FontWeight="Bold"/>
                    <TextBox Grid.Row="1" x:Name="TtsInputTextBox" TextWrapping="Wrap" Height="100"/>
                    <Button Grid.Row="2" x:Name="TtsGenerateButton" Content="生成语音"/>
                    <TextBlock Grid.Row="3" x:Name="TtsStatusTextBlock" Foreground="Green"/>
                    <TextBlock Grid.Row="4" Text="ASR (语音转文本)" FontWeight="Bold"/>
                    <StackPanel Grid.Row="5" Orientation="Horizontal">
                        <Button x:Name="AsrStartButton" Content="开始录音"/>
                        <Button x:Name="AsrStopButton" Content="停止录音"/>
                    </StackPanel>
                    <TextBox Grid.Row="6" x:Name="AsrOutputTextBox" TextWrapping="Wrap" Height="100"/>
                    <TextBlock Grid.Row="7" x:Name="AsrStatusTextBlock" Foreground="Green"/>
                </Grid>
            </TabItem>
            <!-- OBS/VTS控制标签页 -->
            <TabItem Header="OBS/VTS控制">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <Button x:Name="ConnectObsButton" Content="连接OBS"/>
                        <Button x:Name="DisconnectObsButton" Content="断开OBS"/>
                        <Button x:Name="ConnectVtsButton" Content="连接VTS"/>
                    </StackPanel>
                    <TabControl Grid.Row="1" x:Name="ControlTabControl">
                        <TabItem Header="OBS控制">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button x:Name="StartRecordingButton" Content="开始录制"/>
                                    <Button x:Name="StopRecordingButton" Content="停止录制"/>
                                    <Button x:Name="StartStreamingButton" Content="开始推流"/>
                                    <Button x:Name="StopStreamingButton" Content="停止推流"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="场景:"/>
                                    <TextBox x:Name="ObsSceneTextBox" Width="200"/>
                                    <Button x:Name="SetSceneButton" Content="设置场景"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" x:Name="ObsStatusTextBlock" Foreground="Green"/>
                            </Grid>
                        </TabItem>
                        <TabItem Header="VTS控制">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="热键:"/>
                                    <TextBox x:Name="VtsHotkeyTextBox" Width="200"/>
                                    <Button x:Name="TriggerHotkeyButton" Content="触发热键"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="表情:"/>
                                    <TextBox x:Name="VtsExpressionTextBox" Width="200"/>
                                    <Button x:Name="SetExpressionButton" Content="设置表情"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" x:Name="VtsStatusTextBlock" Foreground="Green"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <!-- 系统状态标签页 -->
            <TabItem Header="系统状态">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="后端服务状态:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" x:Name="BackendStatusTextBlock" Foreground="Green"/>
                    <Button Grid.Row="2" x:Name="RefreshStatusButton" Content="刷新状态"/>
                    <ListBox Grid.Row="3" x:Name="SystemLogListBox" Margin="5"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>