<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AIVtuberTool.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIVtuberTool"
        mc:Ignorable="d"
        Title="NekoShizukuAI Launcher - Kawaii Edition"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFF8F8FF"
        Foreground="#FF333366"
        ResizeMode="NoResize">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题区域 - 萌系风格 -->
        <Border Grid.Row="0" Background="#FFE8E8FF" 
                BorderBrush="#FF6A6AFF" 
                BorderThickness="0,0,0,3">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="0,0,20,20"/>
                    <Setter Property="Padding" Value="20"/>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🐱 NekoShizukuAI VTuber Suite" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           Foreground="#FF6A6AFF" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>
                <TextBlock Text="选择您的控制界面" 
                           FontSize="18" 
                           Foreground="#FF333366" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- 主要内容区域 -->
        <Grid Grid.Row="1" Margin="40,30,40,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 经典界面选项 -->
            <Border Grid.Column="0" 
                    Background="White" 
                    BorderBrush="#FF6A6AFF" 
                    BorderThickness="2"
                    Margin="0,0,10,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                        <Setter Property="Padding" Value="20"/>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="⚙️" 
                               FontSize="60" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBlock Text="Classic Interface" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#FF333366" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="传统的多标签页界面，功能完整，适合熟悉操作的用户" 
                               FontSize="12" 
                               Foreground="#FF333366" 
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <Button x:Name="LaunchClassicButton" 
                            Content="启动经典版" 
                            Background="#FFE8E8FF"
                            Foreground="#FF333366"
                            BorderBrush="#FF6A6AFF"
                            BorderThickness="2"
                            Height="40"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="15,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="20"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF6A6AFF"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#FF5555CC"/>
                                                    <Setter Property="BorderBrush" Value="#FF5555CC"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.6"/>
                                                    <Setter Property="Background" Value="#FFE0E0EE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- 现代化界面选项 -->
            <Border Grid.Column="1" 
                    Background="White" 
                    BorderBrush="#FF64B5F6" 
                    BorderThickness="2"
                    Margin="10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                        <Setter Property="Padding" Value="20"/>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="✨" 
                               FontSize="60" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBlock Text="Modern Interface" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#FF333366" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="现代化扁平设计界面，直观易用，全新用户体验" 
                               FontSize="12" 
                               Foreground="#FF333366" 
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <Button x:Name="LaunchModernButton" 
                            Content="启动现代版" 
                            Background="#FF64B5F6"
                            Foreground="White"
                            BorderBrush="#FF64B5F6"
                            BorderThickness="2"
                            Height="40"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="15,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="20"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF5555CC"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#FF5555CC"/>
                                                    <Setter Property="BorderBrush" Value="#FF5555CC"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.6"/>
                                                    <Setter Property="Background" Value="#FFE0E0EE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- 萌系界面选项 -->
            <Border Grid.Column="2" 
                    Background="White" 
                    BorderBrush="#FF6A6AFF" 
                    BorderThickness="3"
                    Margin="10,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                        <Setter Property="Padding" Value="20"/>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="💝" 
                               FontSize="60" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>
                    <TextBlock Text="Kawaii Interface" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#FF6A6AFF" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="可爱的萌系界面，色彩丰富，带来愉悦的视觉体验" 
                               FontSize="12" 
                               Foreground="#FF333366" 
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>
                    <Button x:Name="LaunchKawaiiButton" 
                            Content="启动Kawaii版本" 
                            Background="#FF6A6AFF"
                            Foreground="White"
                            BorderBrush="#FF6A6AFF"
                            BorderThickness="2"
                            Height="40"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="15,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="20"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF5555CC"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#FF5555CC"/>
                                                    <Setter Property="BorderBrush" Value="#FF5555CC"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Opacity" Value="0.6"/>
                                                    <Setter Property="Background" Value="#FFE0E0EE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- 底部状态区域 -->
        <Border Grid.Row="2" Background="#FFE8E8FF" 
                BorderBrush="#FF6A6AFF" 
                BorderThickness="0,3,0,0"
                Padding="15">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20,20,0,0"/>
                </Style>
            </Border.Style>
            <StackPanel>
                <Separator Background="#FF6A6AFF" Margin="0,0,0,10" Height="2"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Backend Status: " FontSize="14" Foreground="#FF333366" Margin="0,0,5,0"/>
                    <TextBlock x:Name="BackendStatusText" Text="🔴 Offline" FontSize="14" Foreground="#FFE57373" Margin="0,0,20,0"/>
                    <TextBlock Text="Version: " FontSize="14" Foreground="#FF333366" Margin="0,0,5,0"/>
                    <TextBlock Text="1.0.0" FontSize="14" Foreground="#FF333366"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="./KawaiiStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
</Window>